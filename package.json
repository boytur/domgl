{
  "name": "domgl",
  "version": "0.1.0",
  "description": "Transpile DOM + GSAP scenes into textures and per-frame transforms, replay them on WebGL, and encode with hardware H.264 (WebCodecs).",
  "license": "MIT",
  "type": "module",
  "bin": {
    "domgl": "./dist/cli.js"
  },
  "main": "./dist/types.js",
  "types": "./dist/types.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli.ts",
    "test": "node --test dist/test/*.test.js"
  },
  "keywords": [
    "webgl",
    "webcodecs",
    "gsap",
    "html",
    "renderer",
    "video",
    "h264",
    "animation"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "puppeteer-core": "^24.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
